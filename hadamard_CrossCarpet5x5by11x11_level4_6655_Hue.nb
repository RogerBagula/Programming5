        RowBox[{"j", ",", "2", ",", "LM"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", "LM"}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"N2", "=", 
