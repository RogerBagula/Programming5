 RowBox[{
  RowBox[{
   RowBox[{"Clear", "[", "HadamardMatrixa", "]"}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"MatrixJoinH", "[", 
     RowBox[{"A_", ",", "B_"}], "]"}], ":=", 
    RowBox[{"Transpose", "[", 
     RowBox[{"Join", "[", 
      RowBox[{
       RowBox[{"Transpose", "[", "A", "]"}], ",", 
       RowBox[{"Transpose", "[", "B", "]"}]}], "]"}], "]"}]}], ";"}], 
  "\n"}], "\n", 
 RowBox[{
  RowBox[{"KroneckerProducta", "[", 
   RowBox[{"M_", ",", "N_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"M1", ",", "N1", ",", "LM", ",", "LN", ",", "N2"}], "}"}], ",", 
    RowBox[{
     RowBox[{"M1", "=", "M"}], ";", "\[IndentingNewLine]", 
     RowBox[{"N1", "=", "N"}], ";", "\[IndentingNewLine]", 
     RowBox[{"LM", "=", 
      RowBox[{"Length", "[", "M1", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"LN", "=", 
      RowBox[{"Length", "[", "N1", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"M1", "[", 
         RowBox[{"[", 
          RowBox[{"i", ",", "j"}], "]"}], "]"}], "=", 
        RowBox[{
         RowBox[{"M1", "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", "j"}], "]"}], "]"}], "N1"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", "LM"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", "1", ",", "LM"}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"M1", "[", 
         RowBox[{"[", 
          RowBox[{"i", ",", "1"}], "]"}], "]"}], "=", 
        RowBox[{"MatrixJoinH", "[", 
         RowBox[{
          RowBox[{"M1", "[", 
           RowBox[{"[", 
            RowBox[{"i", ",", "1"}], "]"}], "]"}], ",", 
          RowBox[{"M1", "[", 
           RowBox[{"[", 
            RowBox[{"i", ",", "j"}], "]"}], "]"}]}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", "2", ",", "LM"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", "LM"}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"N2", "=", 
      RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{"AppendTo", "[", 
        RowBox[{"N2", ",", 
         RowBox[{"M1", "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", "1"}], "]"}], "]"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", "LM"}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"N2", "=", 
      RowBox[{"Flatten", "[", "N2", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Partition", "[", 
      RowBox[{"N2", ",", 
       RowBox[{"LM", "*", "LN"}], ",", 
       RowBox[{"LM", "*", "LN"}]}], "]"}]}]}], "]"}]}], "\n"}], "Input",
