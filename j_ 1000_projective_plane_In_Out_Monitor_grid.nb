Cell[CellGroupData[{

Cell["3D Mandelbrot/Julia", "Subsubsection",
 Evaluatable->False,
 CellHorizontalScrolling->True,
 InitializationCell->True,
 CellChangeTimes->{{3.861866039559484*^9, 3.861866044742983*^9}},
 AspectRatioFixed->True,
 FontFamily->"Courier",
 FontSize->14,ExpressionUUID->"b10f0e05-4d03-4021-acd8-6f2f65bdebd5"],

Cell["\<\
(*Mandelbrot/Julia with SQRT(x^2+y^2) limited measure*)
(*by R. L. BAGULA 18May2022 \[Copyright] *)
numberOfz2ToEscape[z_] := Block[
\t{escapeCount, nz = N[z],nzold=0},
\tFor[
\t\tescapeCount = 0,
\t\t(Sqrt[Re[nz]^2+Im[nz]^2] < 128) && (escapeCount < 1024) && \
(Abs[nz-nzold]>10^(-3)),
\t\tnzold=nz;
\t\tnz=f[nz];
\t\t++escapeCount
\t];
\tescapeCount*If[(Abs[nz-nzold]>10^(-3)),Abs[ArcTan[nz]+I*ArcTan[nz]*Tan[1]-\
Arg[z]],Abs[Arg[nz]]]
]\
\>", "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.636885471970562*^9, 3.636885495570519*^9}, {
   3.636886113868834*^9, 3.636886158088616*^9}, 3.636886228723032*^9, {
