                   RowBox[{"Sign", "[", 
                    RowBox[{"xi", "+", 
                    RowBox[{"v", "/", "2"}]}], "]"}], " ", "0.2", "*", "u", 
                   " ", 
                   RowBox[{"(", 
                    RowBox[{"1", "-", 
                    RowBox[{"Exp", "[", 
                    RowBox[{
                    RowBox[{"-", "5."}], " ", 
                    RowBox[{"Abs", "[", 
                    RowBox[{"xi", "+", 
                    RowBox[{"v", "/", "2"}]}], "]"}]}], "]"}]}], ")"}]}]}]}], 
                ",", 
                RowBox[{"(*", 
                 RowBox[{"branch", " ", 
                  RowBox[{"A", ":", 
                   RowBox[{"use", " ", "trace", " ", "tA"}]}]}], "*)"}], 
                RowBox[{
                 RowBox[{"If", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"Abs", "[", 
                    RowBox[{"zi", "-", "low"}], "]"}], "<", 
                    RowBox[{"10", "^", 
                    RowBox[{"-", "4"}]}]}], ",", 
                   RowBox[{
                    RowBox[{"k", "=", 
                    RowBox[{"-", "n"}]}], ";", 
                    RowBox[{"Break", "[", "]"}]}], ",", 
                   RowBox[{"low", "=", "zi"}]}], "]"}], ";", 
                 "\[IndentingNewLine]", 
                 RowBox[{"k", "=", "1"}], ";", "\[IndentingNewLine]", 
