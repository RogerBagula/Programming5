           "\[IndentingNewLine]", 
           RowBox[{"zi", "=", 
            RowBox[{"(", 
             RowBox[{"1.", "+", "I"}], ")"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"Do", "[", 
            RowBox[{"(*", 
             RowBox[{
             "fold", " ", "x", " ", "coordinate", " ", "into", " ", 
