             RowBox[{"(", 
              RowBox[{"tabVal", "-", "2"}], ")"}], " ", "tb"}], ")"}], "/", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"tb", " ", "tabVal"}], "-", 
             RowBox[{"2", " ", "ta"}], "+", 
             RowBox[{"2", " ", "I", " ", "tabVal"}]}], ")"}]}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"ab", "=", 
