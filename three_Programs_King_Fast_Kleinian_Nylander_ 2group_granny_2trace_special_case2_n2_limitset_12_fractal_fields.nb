    RowBox[{
     RowBox[{
      RowBox[{"grandma", "[", 
       RowBox[{"ta_", ",", "tb_", ",", 
        RowBox[{"posroot_", ":", "False"}], ",", 
        RowBox[{"opt_", ":", "0"}], ",", 
        RowBox[{"tab_", ":", "None"}]}], "]"}], ":=", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
         "p", ",", "q", ",", "tabVal", ",", "z0", ",", "ab", ",", "a", ",", 
          "b"}], "}"}], ",", 
        RowBox[{
         RowBox[{"p", "=", 
          RowBox[{
           RowBox[{"-", "ta"}], " ", "tb"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"q", "=", 
          RowBox[{
           RowBox[{"ta", "^", "2"}], "+", 
           RowBox[{"tb", "^", "2"}]}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"tabVal", "=", 
          RowBox[{"If", "[", 
           RowBox[{"posroot", ",", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"-", "p"}], "+", 
               RowBox[{"Sqrt", "[", 
                RowBox[{
                 RowBox[{"p", "^", "2"}], "-", 
                 RowBox[{"4", " ", "q"}]}], "]"}]}], ")"}], "/", "2"}], ",", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"-", "p"}], "-", 
               RowBox[{"Sqrt", "[", 
                RowBox[{
                 RowBox[{"p", "^", "2"}], "-", 
                 RowBox[{"4", " ", "q"}]}], "]"}]}], ")"}], "/", "2"}]}], 
           "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"z0", "=", 
          RowBox[{
           RowBox[{"(", 
