          RowBox[{"{", 
           RowBox[{"z", ",", "_Complex"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"t1c", ",", "_Complex"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"t2c", ",", "_Complex"}], "}"}]}], "}"}], ",", 
        RowBox[{"Module", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"u", ",", "v", ",", "xi", ",", "yi", ",", "zi", ",", 
            RowBox[{"k", "=", "1"}], ",", 
            RowBox[{"low", "=", 
             RowBox[{"1", "+", "I"}]}], ",", 
            RowBox[{"high", "=", 
             RowBox[{"1", "+", "I"}]}], ",", "n", ",", "tForSep", ",", "tA", 
            ",", "tB"}], "}"}], ",", 
          RowBox[{"(*", 
           RowBox[{
            RowBox[{
            "choose", " ", "which", " ", "trace", " ", "controls", " ", "the",
              " ", "separation"}], "-", 
            RowBox[{"line", " ", "geometry", " ", 
             RowBox[{"(", 
              RowBox[{"use", " ", "t2", " ", "by", " ", "default"}], 
              ")"}]}]}], "*)"}], 
          RowBox[{
           RowBox[{"tForSep", "=", "t2c"}], ";", "\[IndentingNewLine]", 
           RowBox[{"tA", "=", "t1c"}], ";", 
           RowBox[{"(*", 
            RowBox[{
            "used", " ", "in", " ", "one", " ", "M\[ODoubleDot]bius", " ", 
             "branch"}], "*)"}], 
           RowBox[{"tB", "=", "t2c"}], ";", 
           RowBox[{"(*", 
            RowBox[{
            "used", " ", "in", " ", "the", " ", "other", " ", 
             "M\[ODoubleDot]bius", " ", "branch"}], "*)"}], 
           RowBox[{"xi", "=", 
