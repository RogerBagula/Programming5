           RowBox[{"yi", "=", 
            RowBox[{"Im", "[", "z", "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"u", "=", 
            RowBox[{"Re", "[", "tForSep", "]"}]}], ";", 
           RowBox[{"v", "=", 
            RowBox[{"Im", "[", "tForSep", "]"}]}], ";", "\[IndentingNewLine]", 
