       RowBox[{"2000", ",", "2000"}], "}"}]}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.995188704679687*^9, 3.995188709232602*^9}, {
  3.995188811707814*^9, 3.995188817971121*^9}},
 CellLabel->"In[4]:=",ExpressionUUID->"11c6f479-ab64-4d30-9e54-81d304513106"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Export", "[", 
  RowBox[{
  "\"\<Quasiconformal_Hyperbolic_mapping_Complex_Plots.jpg\>\"", ",", 
   RowBox[{"{", 
    RowBox[{"g1", ",", "g2"}], "}"}]}], "]"}]], "Input",
