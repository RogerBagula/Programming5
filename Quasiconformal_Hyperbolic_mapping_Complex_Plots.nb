Cell[BoxData[
 RowBox[{"Clear", "[", 
  RowBox[{"f", ",", "x", ",", "y", ",", "z"}], "]"}]], "Input",
 CellChangeTimes->{{3.9951876202533293`*^9, 3.995187628674366*^9}},
 CellLabel->"In[1]:=",ExpressionUUID->"eca607f0-b716-4344-83fc-b55a084806ae"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"f", "[", "z_", "]"}], "=", " ", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      RowBox[{"Re", "[", "z", "]"}], "^", "2"}], "-", 
     RowBox[{
      RowBox[{"Tanh", "[", "z", "]"}], "*", 
      RowBox[{
       RowBox[{"Im", "[", "z", "]"}], "^", "2"}]}]}], ")"}], "+", 
   RowBox[{"2", "*", "I", "*", 
    RowBox[{"Sech", "[", "z", "]"}], "*", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"Re", "[", "z", "]"}], "*", 
      RowBox[{
       RowBox[{"Im", "[", "z", "]"}], "^", "2"}]}], ")"}]}]}]}]], "Input",
 CellChangeTimes->{{3.995187529472645*^9, 3.995187616047042*^9}, {
  3.9952704869944344`*^9, 3.9952705444090977`*^9}, {3.9952706289821*^9, 
  3.995270641028947*^9}},
 CellLabel->"In[2]:=",ExpressionUUID->"bd0dcac5-3cd2-4074-a43e-ee30b0e0ab15"],

Cell[BoxData[
 RowBox[{
  SuperscriptBox[
   RowBox[{"Re", "[", "z", "]"}], "2"], "+", 
  RowBox[{"2", " ", "\[ImaginaryI]", " ", 
   SuperscriptBox[
    RowBox[{"Im", "[", "z", "]"}], "2"], " ", 
   RowBox[{"Re", "[", "z", "]"}], " ", 
   RowBox[{"Sech", "[", "z", "]"}]}], "-", 
  RowBox[{
   SuperscriptBox[
    RowBox[{"Im", "[", "z", "]"}], "2"], " ", 
   RowBox[{"Tanh", "[", "z", "]"}]}]}]], "Output",
 CellChangeTimes->{3.995270652137793*^9},
 CellLabel->"Out[2]=",ExpressionUUID->"e045d9b0-ed49-4542-8bcb-04caacb1c8ed"]
}, Open  ]],

Cell[BoxData[
 RowBox[{
  RowBox[{"g1", "=", 
   RowBox[{"ComplexPlot", "[", 
    RowBox[{
     RowBox[{"f", "[", "z", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"z", ",", 
       RowBox[{
        RowBox[{"-", "3"}], "-", 
        RowBox[{"I", "*", "3"}]}], ",", 
       RowBox[{"3", "+", 
        RowBox[{"3", "*", "I"}]}]}], "}"}], ",", 
     RowBox[{"ColorFunction", "->", "\"\<CyclicReImLogAbs\>\""}], ",", 
     RowBox[{"ImageSize", "->", 
      RowBox[{"{", 
       RowBox[{"2000", ",", "2000"}], "}"}]}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.995187632275909*^9, 3.995187657839736*^9}, {
  3.995187715131612*^9, 3.995187750635983*^9}, {3.99518861142178*^9, 
  3.995188647354506*^9}, {3.995188797337083*^9, 3.9951888037475243`*^9}},
 CellLabel->"In[3]:=",ExpressionUUID->"f23226b2-a412-497a-8eaa-3f419c6d3483"],

Cell[BoxData[
 RowBox[{
  RowBox[{"g2", "=", 
   RowBox[{"ComplexPlot3D", "[", 
    RowBox[{
     RowBox[{"f", "[", "z", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"z", ",", 
       RowBox[{
        RowBox[{"-", "3"}], "-", 
        RowBox[{"I", "*", "3"}]}], ",", 
       RowBox[{"3", "+", 
        RowBox[{"3", "*", "I"}]}]}], "}"}], ",", 
