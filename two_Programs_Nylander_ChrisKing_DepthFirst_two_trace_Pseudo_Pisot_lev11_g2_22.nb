      ";", "\[IndentingNewLine]", 
      RowBox[{"tags", "=", 
       RowBox[{"ConstantArray", "[", 
        RowBox[{"1", ",", "maxLev"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"lev", "=", "1"}], ";", "\[IndentingNewLine]", 
