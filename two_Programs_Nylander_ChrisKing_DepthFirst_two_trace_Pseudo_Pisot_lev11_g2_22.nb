             "]"}]}], "]"}]}], ";"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", "4"}], "}"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"word", "=", 
       RowBox[{"ConstantArray", "[", 
