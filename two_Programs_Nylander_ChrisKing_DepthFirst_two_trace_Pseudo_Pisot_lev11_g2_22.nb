Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Clear", "[", "DepthFirstSegments", "]"}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"DepthFirstSegments", "[", 
    RowBox[{"A_", ",", "B_", ",", 
     RowBox[{"ep_", ":", "0.001"}], ",", 
     RowBox[{"levmax_", ":", "1000"}], ",", 
     RowBox[{"spec_", ":", "0"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"epScaled", "=", "ep"}], ",", "posroot", ",", "a", ",", "b", 
       ",", "gens", ",", "fix", ",", "word", ",", "tags", ",", "lev", ",", 
       "maxLev", ",", "newpoint", ",", "oldpoint", ",", "midpoint", ",", 
       "plt", ",", "segments"}], "}"}], ",", 
     RowBox[{
