Cell[CellGroupData[{

Cell["3D Mandelbrot /Julia", "Subsubsection",
 Evaluatable->False,
 CellHorizontalScrolling->True,
 InitializationCell->True,
 CellChangeTimes->{{3.997944675144854*^9, 3.997944684192648*^9}},
 AspectRatioFixed->True,
 FontFamily->"Courier",
 FontSize->14,ExpressionUUID->"8139299e-a23d-463f-a164-49c7c649d165"],

Cell["\<\
(*Mandelbrot with SQRT(x^2+y^2) limited measure*)
(*by R. L. BAGULA 25 Mov 2005 \[Copyright] *)
numberOfz2ToEscape[z_] := Block[
\t{escapeCount, nz = N[z],nzold=0},
\tFor[
\t\tescapeCount = 0,
\t\t(Sqrt[Re[nz]^2+Im[nz]^2] < 16) && (escapeCount < 255) && \
(Abs[nz-nzold]>10^(-3)),
\t\tnzold=nz;
\t\tnz=p[nz];
\t\t++escapeCount
\t];
\tescapeCount*If[(Abs[nz-nzold]>10^(-3)),Abs[ArcTan[nz]+I*ArcTan[nz]*Tan[1]-\
Arg[z]],Arg[nz]]
\t]\
\>", "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.636885471970562*^9, 3.636885495570519*^9}, {
   3.636886113868834*^9, 3.636886158088616*^9}, 3.636886228723032*^9, {
