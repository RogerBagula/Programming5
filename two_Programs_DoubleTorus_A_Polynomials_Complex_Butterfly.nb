Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"::", "Section", "::"}], "*)"}], 
  RowBox[{"(*", 
   RowBox[{"Plot", " ", "buffer", " ", "and", " ", "helpers"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"Clear", "[", 
     RowBox[{"initBuffer", ",", "plotSegment"}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"initBuffer", "[", "size_", "]"}], ":=", 
     RowBox[{"ConstantArray", "[", 
      RowBox[{"256", ",", 
       RowBox[{"{", 
        RowBox[{"size", ",", "size"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"safeSetPixel", "[", 
      RowBox[{"M_", ",", "r_", ",", "c_", ",", "co_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "}"}], ",", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"IntegerQ", "[", "r", "]"}], "&&", 
           RowBox[{"IntegerQ", "[", "c", "]"}], "&&", 
           RowBox[{"1", "<=", "r", "<=", 
            RowBox[{"Length", "[", "M", "]"}]}], "&&", 
           RowBox[{"1", "<=", "c", "<=", 
            RowBox[{"Length", "[", 
             RowBox[{"M", "[", 
              RowBox[{"[", "1", "]"}], "]"}], "]"}]}]}], ",", 
          RowBox[{
           RowBox[{"M", "[", 
            RowBox[{"[", 
             RowBox[{"r", ",", "c"}], "]"}], "]"}], "=", "co"}]}], "]"}], ";",
         "\[IndentingNewLine]", "M"}]}], "]"}]}], ";"}], "\n"}]}]], "Input",
 CellChangeTimes->{{3.9938063141815434`*^9, 3.99380631418414*^9}, 
   3.9938065663784943`*^9, {3.993806887346808*^9, 3.993806904606374*^9}, 
   3.9938072459495077`*^9},
 CellLabel->
  "In[124]:=",ExpressionUUID->"c02dc9ec-923f-4470-8c3a-2a56fe34c64e"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"plotSegment", "[", 
     RowBox[{
     "M_", ",", "o_", ",", "n_", ",", "scale_", ",", "size_", ",", "color_"}],
      "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"steps", ",", "zs", ",", 
        RowBox[{"s2", "=", 
         RowBox[{"size", "/", "2"}]}]}], "}"}], ",", 
      RowBox[{
       RowBox[{"steps", "=", 
        RowBox[{"Max", "[", 
         RowBox[{"2", ",", 
          RowBox[{"Ceiling", "[", 
           RowBox[{
            RowBox[{"Abs", "[", 
             RowBox[{"scale", " ", 
              RowBox[{"(", 
               RowBox[{"n", "-", "o"}], ")"}]}], "]"}], " ", "size"}], 
           "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"zs", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"o", "+", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"n", "-", "o"}], ")"}], " ", "t"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"t", ",", "0", ",", "1", ",", 
            RowBox[{"1", "/", 
             RowBox[{"(", 
              RowBox[{"steps", "-", "1"}], ")"}]}]}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"NumericQ", "[", "z", "]"}], "&&", 
            RowBox[{"z", "==", "z"}], "&&", 
            RowBox[{"(*", 
             RowBox[{"not", " ", "NaN"}], "*)"}], 
            RowBox[{
             RowBox[{"Max", "[", 
              RowBox[{
               RowBox[{"Abs", "[", 
                RowBox[{"Re", "[", "z", "]"}], "]"}], ",", 
               RowBox[{"Abs", "[", 
                RowBox[{"Im", "[", "z", "]"}], "]"}]}], "]"}], "<", "1"}]}], 
           ",", 
           RowBox[{
            RowBox[{"M", "=", 
             RowBox[{"safeSetPixel", "[", 
              RowBox[{"M", ",", 
               RowBox[{"Round", "[", 
                RowBox[{"s2", "-", 
                 RowBox[{"s2", "*", 
                  RowBox[{"Re", "[", "z", "]"}]}]}], "]"}], ",", 
               RowBox[{"Round", "[", 
                RowBox[{"s2", "-", 
                 RowBox[{"s2", "*", 
                  RowBox[{"Im", "[", "z", "]"}]}]}], "]"}], ",", "color"}], 
              "]"}]}], ";"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"z", ",", "zs"}], "}"}]}], "]"}], ";", 
       "\[IndentingNewLine]", "M"}]}], "]"}]}], ";"}], "\n"}]], "Input",
 CellChangeTimes->{{3.993807260734165*^9, 3.9938072607430773`*^9}},
 CellLabel->
  "In[127]:=",ExpressionUUID->"8a703ef4-89a8-4af0-a828-3c906e604f05"],

Cell[BoxData[
 RowBox[{"\n", 
  RowBox[{
