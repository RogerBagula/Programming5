          RowBox[{
           RowBox[{"m", "=", 
            RowBox[{"RotateLeft", "[", 
             RowBox[{"IdentityMatrix", "[", "deg", "]"}], "]"}]}], ";", " ", 
           RowBox[{
            RowBox[{"m", "[", 
             RowBox[{"[", " ", 
              RowBox[{"-", "1"}], "]"}], "]"}], "=", 
