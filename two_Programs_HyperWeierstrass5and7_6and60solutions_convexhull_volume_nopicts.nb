           RowBox[{"-", "1"}]}], "]"}]}], ";", " ", 
        RowBox[{"deg", "=", 
         RowBox[{"Length", "[", "cl", "]"}]}], ";", " ", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"deg", "==", "1"}], ",", " ", 
          RowBox[{"{", 
