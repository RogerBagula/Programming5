 "\n",
 Cell[BoxData[
  RowBox[{
   RowBox[{"(*", " ", 
    RowBox[{"::", "Section", "::"}], "*)"}], 
   RowBox[{"(*", 
    RowBox[{"Core", " ", "M\[ODoubleDot]bius", " ", "tools"}], "*)"}], 
   RowBox[{
    RowBox[{
     RowBox[{"Clear", "[", 
      RowBox[{"mobius", ",", "fixPoint"}], "]"}], ";"}], 
    "\[IndentingNewLine]", "\n", 
    RowBox[{
     RowBox[{
      RowBox[{"mobius", "[", 
       RowBox[{"T_", ",", "z_"}], "]"}], ":=", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"T", "[", 
           RowBox[{"[", 
            RowBox[{"1", ",", "1"}], "]"}], "]"}], " ", "z"}], "+", 
         RowBox[{"T", "[", 
          RowBox[{"[", 
           RowBox[{"1", ",", "2"}], "]"}], "]"}]}], ")"}], "/", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"T", "[", 
           RowBox[{"[", 
            RowBox[{"2", ",", "1"}], "]"}], "]"}], " ", "z"}], "+", 
         RowBox[{"T", "[", 
          RowBox[{"[", 
           RowBox[{"2", ",", "2"}], "]"}], "]"}]}], ")"}]}]}], ";"}], 
    "\[IndentingNewLine]", "\n", 
    RowBox[{
     RowBox[{
      RowBox[{"fixPoint", "[", "T_", "]"}], ":=", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
         "a", ",", "b", ",", "c", ",", "d", ",", "tr", ",", "tr2", ",", "k"}],
          "}"}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{"a", ",", "b", ",", "c", ",", "d"}], "}"}], "=", 
          RowBox[{"Flatten", "[", "T", "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"tr", "=", 
          RowBox[{"a", "+", "d"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"tr2", "=", 
          RowBox[{"Tr", "[", 
           RowBox[{"T", ".", "T"}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"k", "=", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"tr", "+", 
               RowBox[{"Sqrt", "[", 
                RowBox[{"tr2", "-", "4"}], "]"}]}], ")"}], "/", "2"}], ")"}], 
           "^", "2"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Abs", "[", "k", "]"}], ">", "1"}], ",", 
           RowBox[{
            RowBox[{"Sqrt", "[", 
             RowBox[{
              RowBox[{"-", 
               RowBox[{"(", 
                RowBox[{"d", "-", "a"}], ")"}]}], "+", 
              RowBox[{"Sqrt", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"d", "-", "a"}], ")"}], "^", "2"}], "+", 
                RowBox[{"4", " ", "b", " ", "c"}]}], "]"}]}], "]"}], "/", 
            RowBox[{"(", 
             RowBox[{"2", " ", "c"}], ")"}]}], ",", 
           RowBox[{
            RowBox[{"Sqrt", "[", 
             RowBox[{
              RowBox[{"-", 
               RowBox[{"(", 
                RowBox[{"d", "-", "a"}], ")"}]}], "-", 
              RowBox[{"Sqrt", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"d", "-", "a"}], ")"}], "^", "2"}], "+", 
                RowBox[{"4", " ", "b", " ", "c"}]}], "]"}]}], "]"}], "/", 
            RowBox[{"(", 
             RowBox[{"2", " ", "c"}], ")"}]}]}], "]"}]}]}], "]"}]}], 
     ";"}]}]}]], "Input",
