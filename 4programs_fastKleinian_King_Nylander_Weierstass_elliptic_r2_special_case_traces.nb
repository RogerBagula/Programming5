 Cell[BoxData[
  RowBox[{
   RowBox[{"(*", " ", 
    RowBox[{"::", "Section", "::"}], "*)"}], 
   RowBox[{"(*", 
    RowBox[{"Plot", " ", "buffer", " ", "and", " ", "helpers"}], "*)"}], 
   RowBox[{
    RowBox[{
     RowBox[{"Clear", "[", 
      RowBox[{"initBuffer", ",", "plotSegment"}], "]"}], ";"}], 
    "\[IndentingNewLine]", "\n", 
    RowBox[{
     RowBox[{
      RowBox[{"initBuffer", "[", "size_", "]"}], ":=", 
      RowBox[{"ConstantArray", "[", 
       RowBox[{"256", ",", 
        RowBox[{"{", 
         RowBox[{"size", ",", "size"}], "}"}]}], "]"}]}], ";"}], 
    "\[IndentingNewLine]", "\n", 
    RowBox[{
     RowBox[{
      RowBox[{"safeSetPixel", "[", 
       RowBox[{"M_", ",", "r_", ",", "c_", ",", "co_"}], "]"}], ":=", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", "}"}], ",", 
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"IntegerQ", "[", "r", "]"}], "&&", 
            RowBox[{"IntegerQ", "[", "c", "]"}], "&&", 
            RowBox[{"1", "<=", "r", "<=", 
             RowBox[{"Length", "[", "M", "]"}]}], "&&", 
            RowBox[{"1", "<=", "c", "<=", 
             RowBox[{"Length", "[", 
              RowBox[{"M", "[", 
               RowBox[{"[", "1", "]"}], "]"}], "]"}]}]}], ",", 
           RowBox[{
            RowBox[{"M", "[", 
             RowBox[{"[", 
              RowBox[{"r", ",", "c"}], "]"}], "]"}], "=", "co"}]}], "]"}], 
         ";", "\[IndentingNewLine]", "M"}]}], "]"}]}], ";"}], "\n"}]}]], 
  "Input",
  CellChangeTimes->{{3.9938063141815434`*^9, 3.99380631418414*^9}, 
