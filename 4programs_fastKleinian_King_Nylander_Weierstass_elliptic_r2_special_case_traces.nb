 Cell[BoxData[{
  RowBox[{
   RowBox[{
    RowBox[{"Clear", "[", "DepthFirstSegments", "]"}], ";"}], 
   "\[IndentingNewLine]"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"DepthFirstSegments", "[", 
     RowBox[{"A_", ",", "B_", ",", 
      RowBox[{"ep_", ":", "0.001"}], ",", 
      RowBox[{"levmax_", ":", "1000"}], ",", 
      RowBox[{"spec_", ":", "0"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"epScaled", "=", "ep"}], ",", "posroot", ",", "a", ",", "b", 
        ",", "gens", ",", "fix", ",", "word", ",", "tags", ",", "lev", ",", 
        "maxLev", ",", "newpoint", ",", "oldpoint", ",", "midpoint", ",", 
        "plt", ",", "segments"}], "}"}], ",", 
      RowBox[{
       RowBox[{"posroot", "=", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Mod", "[", 
            RowBox[{"spec", ",", "8"}], "]"}], ">=", "4"}], ",", "True", ",", 
          "False"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"a", ",", "b"}], "}"}], "=", 
        RowBox[{"grandma", "[", 
         RowBox[{"A", ",", "B", ",", "posroot", ",", "0"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"gens", "=", 
        RowBox[{"{", 
         RowBox[{"a", ",", "b", ",", 
          RowBox[{"Inverse", "[", "a", "]"}], ",", 
          RowBox[{"Inverse", "[", "b", "]"}]}], "}"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"maxLev", "=", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"levmax", "==", "0"}], ",", "10000", ",", "levmax"}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"fix", "=", 
        RowBox[{"Table", "[", 
         RowBox[{"0", ",", 
          RowBox[{"{", "3", "}"}], ",", 
          RowBox[{"{", "4", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"fix", "[", 
            RowBox[{"[", 
             RowBox[{"1", ",", "i"}], "]"}], "]"}], "=", 
           RowBox[{"fixPoint", "[", 
            RowBox[{
             RowBox[{"gens", "[", 
              RowBox[{"[", 
               RowBox[{"Mod", "[", 
                RowBox[{
                 RowBox[{"i", "-", "1"}], ",", "4", ",", "1"}], "]"}], "]"}], 
              "]"}], ".", 
             RowBox[{"gens", "[", 
              RowBox[{"[", 
               RowBox[{"Mod", "[", 
                RowBox[{
                 RowBox[{"i", "-", "2"}], ",", "4", ",", "1"}], "]"}], "]"}], 
              "]"}], ".", 
             RowBox[{"gens", "[", 
              RowBox[{"[", 
               RowBox[{"Mod", "[", 
                RowBox[{
                 RowBox[{"i", "-", "3"}], ",", "4", ",", "1"}], "]"}], "]"}], 
              "]"}], ".", 
             RowBox[{"gens", "[", 
              RowBox[{"[", 
               RowBox[{"Mod", "[", 
                RowBox[{
                 RowBox[{"i", "-", "4"}], ",", "4", ",", "1"}], "]"}], "]"}], 
              "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"fix", "[", 
            RowBox[{"[", 
             RowBox[{"2", ",", "i"}], "]"}], "]"}], "=", 
           RowBox[{"fixPoint", "[", 
            RowBox[{"gens", "[", 
             RowBox[{"[", "i", "]"}], "]"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"fix", "[", 
            RowBox[{"[", 
             RowBox[{"3", ",", "i"}], "]"}], "]"}], "=", 
           RowBox[{"fixPoint", "[", 
