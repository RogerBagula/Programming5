 "\n",
 Cell[BoxData[
  RowBox[{
   RowBox[{"(*", " ", 
    RowBox[{"::", "Section", "::"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Grandma", " ", "generators"}], "*)"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"Clear", "[", "grandma", "]"}], ";"}], "\n", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"grandma", "[", 
       RowBox[{"ta_", ",", "tb_", ",", 
        RowBox[{"posroot_", ":", "False"}], ",", 
        RowBox[{"opt_", ":", "0"}], ",", 
        RowBox[{"tab_", ":", "None"}]}], "]"}], ":=", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
         "p", ",", "q", ",", "tabVal", ",", "z0", ",", "ab", ",", "a", ",", 
          "b"}], "}"}], ",", 
        RowBox[{
         RowBox[{"p", "=", 
          RowBox[{
           RowBox[{"-", "ta"}], " ", "tb"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"q", "=", 
          RowBox[{
           RowBox[{"ta", "^", "2"}], "+", 
           RowBox[{"tb", "^", "2"}]}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"tabVal", "=", 
          RowBox[{"If", "[", 
           RowBox[{"posroot", ",", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"-", "p"}], "+", 
               RowBox[{"Sqrt", "[", 
                RowBox[{
                 RowBox[{"p", "^", "2"}], "-", 
                 RowBox[{"4", " ", "q"}]}], "]"}]}], ")"}], "/", "2"}], ",", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"-", "p"}], "-", 
               RowBox[{"Sqrt", "[", 
                RowBox[{
                 RowBox[{"p", "^", "2"}], "-", 
                 RowBox[{"4", " ", "q"}]}], "]"}]}], ")"}], "/", "2"}]}], 
           "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"z0", "=", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"tabVal", "-", "2"}], ")"}], " ", "tb"}], ")"}], "/", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"tb", " ", "tabVal"}], "-", 
             RowBox[{"2", " ", "ta"}], "+", 
             RowBox[{"2", " ", "I", " ", "tabVal"}]}], ")"}]}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"ab", "=", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"tabVal", "/", "2"}], ",", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"tabVal", "-", "2"}], ")"}], "/", 
               RowBox[{"(", 
                RowBox[{"2", " ", "z0"}], ")"}]}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{"tabVal", "+", "2"}], ")"}], " ", 
               RowBox[{"z0", "/", "2"}]}], ",", 
              RowBox[{"tabVal", "/", "2"}]}], "}"}]}], "}"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"b", "=", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{"tb", "-", 
                 RowBox[{"2", " ", "I"}]}], ")"}], "/", "2"}], ",", 
              RowBox[{"tb", "/", "2"}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"tb", "/", "2"}], ",", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"tb", "+", 
                 RowBox[{"2", " ", "I"}]}], ")"}], "/", "2"}]}], "}"}]}], 
           "}"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"a", "=", 
          RowBox[{"ab", ".", 
           RowBox[{"Inverse", "[", "b", "]"}]}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{"a", ",", "b"}], "}"}]}]}], "]"}]}], ";"}]}]}]], "Input",
