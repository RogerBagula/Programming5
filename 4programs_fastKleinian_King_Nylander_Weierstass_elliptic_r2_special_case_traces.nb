 "\n",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"plotSegment", "[", 
      RowBox[{
      "M_", ",", "o_", ",", "n_", ",", "scale_", ",", "size_", ",", 
       "color_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"steps", ",", "zs", ",", 
         RowBox[{"s2", "=", 
          RowBox[{"size", "/", "2"}]}]}], "}"}], ",", 
       RowBox[{
        RowBox[{"steps", "=", 
         RowBox[{"Max", "[", 
          RowBox[{"2", ",", 
           RowBox[{"Ceiling", "[", 
            RowBox[{
             RowBox[{"Abs", "[", 
              RowBox[{"scale", " ", 
               RowBox[{"(", 
                RowBox[{"n", "-", "o"}], ")"}]}], "]"}], " ", "size"}], 
            "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"zs", "=", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"o", "+", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"n", "-", "o"}], ")"}], " ", "t"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"t", ",", "0", ",", "1", ",", 
             RowBox[{"1", "/", 
              RowBox[{"(", 
               RowBox[{"steps", "-", "1"}], ")"}]}]}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Do", "[", 
         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"NumericQ", "[", "z", "]"}], "&&", 
             RowBox[{"z", "==", "z"}], "&&", 
             RowBox[{"(*", 
              RowBox[{"not", " ", "NaN"}], "*)"}], 
             RowBox[{
              RowBox[{"Max", "[", 
               RowBox[{
                RowBox[{"Abs", "[", 
                 RowBox[{"Re", "[", "z", "]"}], "]"}], ",", 
                RowBox[{"Abs", "[", 
                 RowBox[{"Im", "[", "z", "]"}], "]"}]}], "]"}], "<", "1"}]}], 
            ",", 
            RowBox[{
             RowBox[{"M", "=", 
              RowBox[{"safeSetPixel", "[", 
               RowBox[{"M", ",", 
                RowBox[{"Round", "[", 
                 RowBox[{"s2", "-", 
                  RowBox[{"s2", "*", 
                   RowBox[{"Re", "[", "z", "]"}]}]}], "]"}], ",", 
                RowBox[{"Round", "[", 
                 RowBox[{"s2", "-", 
                  RowBox[{"s2", "*", 
                   RowBox[{"Im", "[", "z", "]"}]}]}], "]"}], ",", "color"}], 
               "]"}]}], ";"}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"z", ",", "zs"}], "}"}]}], "]"}], ";", 
        "\[IndentingNewLine]", "M"}]}], "]"}]}], ";"}], "\n"}]], "Input",
