     RowBox[{"{", 
      RowBox[{"1", ",", 
       RowBox[{"1", "-", "I"}]}], "}"}]}], "}"}]}], ";", 
  RowBox[{"dki", "=", 
   RowBox[{"Inverse", "[", "dk", "]"}]}], ";"}]}], "Input",
