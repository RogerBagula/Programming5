     RowBox[{"{", 
      RowBox[{
       RowBox[{"Sin", "[", "theta", "]"}], ",", 
       RowBox[{"Cos", "[", "theta", "]"}]}], "}"}]}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"s0", "=", 
   RowBox[{"N", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", 
         RowBox[{"-", "I"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "I"}], ",", "1"}], "}"}]}], "}"}], "/", 
     RowBox[{"Sqrt", "[", "2", "]"}]}], "]"}]}], ";", 
  RowBox[{"s1", "=", 
   RowBox[{"Inverse", "[", "s0", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"qf", "=", 
   RowBox[{"N", "[", 
    RowBox[{"rotate", "[", 
