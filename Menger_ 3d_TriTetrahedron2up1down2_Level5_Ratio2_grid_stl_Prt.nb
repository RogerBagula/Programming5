Cell[BoxData[
 RowBox[{"\n", 
  StyleBox[" ",
   FontFamily->"Lucida Grande",
   FontSize->13], 
  RowBox[{
   StyleBox[
    RowBox[{
     RowBox[{
      RowBox[{"menger", "[", 
       RowBox[{"cornerPt_", ",", " ", "sideLen_", ",", " ", "n_"}], "]"}], 
      " ", ":=", "\n", "  ", 
      RowBox[{
       RowBox[{
        RowBox[{"menger", "[", 
         RowBox[{
          RowBox[{"cornerPt", " ", "+", " ", 
           RowBox[{"#1", "*", 
            RowBox[{"(", 
             RowBox[{"sideLen", "/", "2"}], ")"}]}]}], ",", " ", 
          RowBox[{"sideLen", "/", "2"}], ",", " ", 
          RowBox[{"n", " ", "-", " ", "1"}]}], "]"}], " ", "&"}], " ", "/@", 
       " ", "pieces"}]}], ";"}],
    FontFamily->"Lucida Grande",
    FontSize->13], "\n", 
   StyleBox[" ",
    FontFamily->"Lucida Grande",
    FontSize->13], 
   StyleBox[
    RowBox[{
     RowBox[{
      RowBox[{"menger", "[", 
       RowBox[{"cornerPt_", ",", " ", "sideLen_", ",", " ", "0"}], "]"}], " ",
       ":=", "\n", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Hue", "[", 
         RowBox[{"Abs", "[", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"N", "[", 
              RowBox[{"Norm", "[", "cornerPt", "]"}], "]"}], "/", "2"}], "-", 
            
            RowBox[{"1", "/", 
             RowBox[{"(", 
              RowBox[{"1", "+", 
               RowBox[{"N", "[", 
                RowBox[{"Norm", "[", "cornerPt", "]"}], "]"}]}], ")"}]}]}], 
           ")"}], "]"}], "]"}], ",", 
        RowBox[{"Specularity", "[", 
         RowBox[{"White", ",", "30"}], "]"}], ",", 
        RowBox[{"EdgeForm", "[", "]"}], ",", 
        RowBox[{"Cuboid", "[", 
         RowBox[{"cornerPt", ",", " ", 
          RowBox[{"cornerPt", " ", "+", " ", 
           RowBox[{"sideLen", "*", 
            RowBox[{"{", 
             RowBox[{"1", ",", " ", "1", ",", " ", "1"}], "}"}]}]}]}], 
