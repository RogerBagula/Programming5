 RowBox[{
  RowBox[{
   RowBox[{"Gradient2", "[", 
    RowBox[{"x_", ",", "grad_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"i", "=", "1"}], ",", 
       RowBox[{"n", "=", 
        RowBox[{"Length", "[", "grad", "]"}]}]}], "}"}], ",", 
     RowBox[{
      RowBox[{"While", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"i", "\[LessEqual]", "n"}], "&&", 
         RowBox[{
          RowBox[{"grad", "\[LeftDoubleBracket]", 
           RowBox[{"i", ",", "1"}], "\[RightDoubleBracket]"}], "<", "x"}]}], 
        ",", 
        RowBox[{"i", "++"}]}], "]"}], ";", 
      RowBox[{"RGBColor", "@@", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"1", "<", "i", "\[LessEqual]", "n"}], ",", 
         RowBox[{"Module", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"x1", "=", 
              RowBox[{"grad", "\[LeftDoubleBracket]", 
               RowBox[{
                RowBox[{"i", "-", "1"}], ",", "1"}], 
               "\[RightDoubleBracket]"}]}], ",", 
             RowBox[{"x2", "=", 
              RowBox[{"grad", "\[LeftDoubleBracket]", 
