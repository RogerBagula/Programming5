        RowBox[{"c1", "=", 
         RowBox[{"ta", "*", "tb"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"tab", "=", 
         RowBox[{"0.5", "*", 
          RowBox[{"(", 
           RowBox[{"c1", "-", 
            RowBox[{"Sqrt", "[", 
             RowBox[{
