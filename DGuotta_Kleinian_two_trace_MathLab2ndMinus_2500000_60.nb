         RowBox[{"centers", "--"}]}], "-"}]}]}]}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"generatePoints", "[", 
      RowBox[{"gens_List", ",", 
       RowBox[{"numPoints_Integer", "?", "Positive"}], ",", 
       RowBox[{"maxIters_Integer", ":", "20"}]}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"centers", ",", "seen", ",", "queue", ",", "next", ",", 
