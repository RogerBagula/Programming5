        RowBox[{"centers", "=", 
         RowBox[{"CircleCenter", "/@", 
          RowBox[{"(", 
           RowBox[{"GeneratorCircle", "/@", "gens"}], ")"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"seen", "=", 
         RowBox[{"AssociationThread", "[", 
          RowBox[{
           RowBox[{"ToString", "/@", "centers"}], "->", "True"}], "]"}]}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{"queue", "=", "centers"}], ";", "\[IndentingNewLine]", 
        RowBox[{"While", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"Length", "[", "centers", "]"}], "<", "numPoints"}], "&&", 
           RowBox[{"i", "<", "maxIters"}]}], ",", 
          RowBox[{
           RowBox[{"i", "++"}], ";", "\[IndentingNewLine]", 
           RowBox[{"next", "=", 
            RowBox[{"Flatten", "[", 
             RowBox[{
              RowBox[{"Table", "[", 
               RowBox[{
                RowBox[{"mobiusAction", "[", 
                 RowBox[{
